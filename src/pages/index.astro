---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import HeroCurrent from "../components/HeroCurrent.astro";
import Manifesto from "../components/Manifesto.astro";
import VisionMission from "../components/VisionMission.astro";
import ProductTheatre from "../components/ProductTheatre.astro";
import AudienceLens from "../components/AudienceLens.astro";
import FactoryConveyor from "../components/FactoryConveyor.astro";
import QualityGate from "../components/QualityGate.astro";
import MarketRunway from "../components/MarketRunway.astro";
import ValuesOrbit from "../components/ValuesOrbit.astro";
import ResponsibilityMatrix from "../components/ResponsibilityMatrix.astro";
import GrowthModel from "../components/GrowthModel.astro";
import PartnerInvitation from "../components/PartnerInvitation.astro";
import WaterFooter from "../components/WaterFooter.astro";
import WhatsApp from "../components/WhatsApp.astro";
import "../styles/site.css";
---

<Base
  title="مصنع الساقي للمياه المعدنية | الساقي… اختيارك الراقي"
  description="مياه معدنية طبيعية بمعايير جودة عالية وتجربة تعكس الذوق الرفيع"
  lang="ar"
  dir="rtl"
>
  <Header />
  <main>
    <HeroCurrent />
    <Manifesto />
    <VisionMission />
    <ProductTheatre />
    <AudienceLens />
    <FactoryConveyor />
    <QualityGate />
    <MarketRunway />
    <ValuesOrbit />
    <ResponsibilityMatrix />
    <GrowthModel />
    <PartnerInvitation />
  </main>
  <WaterFooter />
  <WhatsApp />
</Base>
