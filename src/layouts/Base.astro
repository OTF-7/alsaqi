---
import "../styles/global.css";
import heroImage from "../assets/alsaqi/01-hero-family.png";

interface Props {
  title: string;
  description: string;
  lang?: string;
  dir?: "ltr" | "rtl";
  lockLanguage?: boolean;
  includeMainScript?: boolean;
}

const {
  title,
  description,
  lang = "en",
  dir = "ltr",
  lockLanguage = false,
  includeMainScript = true,
} = Astro.props;
const ogImage = new URL(heroImage.src, Astro.site);
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#083f68" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={Astro.site} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!lockLanguage && <script is:inline src="/lang-restore.js"></script>}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alexandria:wght@500;600;700&family=Barlow+Condensed:wght@500;600;700&family=Manrope:wght@400;500;600;700&family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    {includeMainScript && <script src="../scripts/main.ts"></script>}
  </body>
</html>
