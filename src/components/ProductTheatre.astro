---
import { Image } from "astro:assets";
import bottle330 from "../assets/alsaqi/cutouts/bottle-330.png";
import bottle750 from "../assets/alsaqi/cutouts/bottle-750.png";
import bottle1200 from "../assets/alsaqi/cutouts/bottle-1200.png";
import { products, productSection } from "../data/alsaqi";

const bottleImages = { "330": bottle330, "750": bottle750, "1200": bottle1200 } as const;
---

<section class="site-section product-section" id="products" data-product-stage data-product="750">
  <div class="site-shell section-content reveal">
    <header class="section-heading split-heading">
      <div><span class="section-number">03</span><h2 data-en={productSection.title.en} data-ar={productSection.title.ar}>{productSection.title.ar}</h2></div>
      <p data-en={productSection.intro.en} data-ar={productSection.intro.ar}>{productSection.intro.ar}</p>
    </header>

    <div class="product-stage">
      <div class="product-visual" aria-live="polite">
        <div class="product-spotlight" aria-hidden="true"></div>
        {products.map((product) => (
          <figure class="product-bottle" tabindex={product.id === "750" ? "0" : "-1"} data-product-image={product.id} aria-hidden={product.id === "750" ? "false" : "true"}>
            <Image src={bottleImages[product.id]} alt={`عبوة الساقي سعة ${product.id} مل`} data-alt-en={`Al Saqi ${product.id} ml bottle`} data-alt-ar={`عبوة الساقي سعة ${product.id} مل`} widths={[280, 440, 640]} sizes="(max-width: 760px) 58vw, 32vw" loading="lazy" />
          </figure>
        ))}
        <div class="product-size-ghost" aria-hidden="true">
          {products.map((product) => <span data-product-size={product.id} data-en={product.size.en} data-ar={product.size.ar}>{product.size.ar}</span>)}
        </div>
      </div>

      <div class="product-control-panel">
        <div class="product-tabs" role="tablist" aria-label="أحجام العبوات" data-aria-en="Bottle sizes" data-aria-ar="أحجام العبوات">
          {products.map((product) => (
            <button id={`product-tab-${product.id}`} type="button" role="tab" data-product-option={product.id} aria-controls={`product-panel-${product.id}`} aria-selected={product.id === "750" ? "true" : "false"}>
              <strong data-en={product.size.en} data-ar={product.size.ar}>{product.size.ar}</strong><span data-en={product.short.en} data-ar={product.short.ar}>{product.short.ar}</span>
            </button>
          ))}
        </div>
        <div class="product-copy-stack">
          {products.map((product) => (
            <article id={`product-panel-${product.id}`} role="tabpanel" aria-labelledby={`product-tab-${product.id}`} data-product-copy={product.id} aria-hidden={product.id === "750" ? "false" : "true"}>
              <p class="product-role" data-en={product.role.en} data-ar={product.role.ar}>{product.role.ar}</p>
              <strong data-en={product.short.en} data-ar={product.short.ar}>{product.short.ar}</strong>
            </article>
          ))}
        </div>
        <p class="strategy-line" data-en={productSection.strategy.en} data-ar={productSection.strategy.ar}>{productSection.strategy.ar}</p>
      </div>
    </div>

    <div class="packaging-strip">
      <p data-en={productSection.packageIntro.en} data-ar={productSection.packageIntro.ar}>{productSection.packageIntro.ar}</p>
      <ol>{productSection.packagePoints.map((point, index) => <li><span>0{index + 1}</span><b data-en={point.en} data-ar={point.ar}>{point.ar}</b></li>)}</ol>
    </div>
    <p class="display-close product-close" data-en={productSection.close.en} data-ar={productSection.close.ar}>{productSection.close.ar}</p>
  </div>
</section>
