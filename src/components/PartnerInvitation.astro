---
import { Image } from "astro:assets";
import partnerPhoto from "../assets/alsaqi/19-retail-crown.jpg";
import { contact, partners } from "../data/alsaqi";
---

<section class="site-section partners-section" id="partners">
  <figure class="partners-photo" aria-hidden="true"><Image src={partnerPhoto} alt="" widths={[900, 1400, 2000]} sizes="100vw" loading="lazy" /></figure>
  <div class="site-shell section-content reveal">
    <header class="section-heading">
      <span class="section-number">11</span>
      <h2 data-en={partners.title.en} data-ar={partners.title.ar}>{partners.title.ar}</h2>
    </header>
    <div class="partner-layout">
      <div class="partner-invite">
        <p data-en={partners.intro.en} data-ar={partners.intro.ar}>{partners.intro.ar}</p>
        <ul>{partners.invitation.map((item) => <li data-en={item.en} data-ar={item.ar}>{item.ar}</li>)}</ul>
      </div>
      <div class="partner-conclusion">
        <p data-en={partners.conclusion.en} data-ar={partners.conclusion.ar}>{partners.conclusion.ar}</p>
        <ul>{partners.conclusionPoints.map((item) => <li data-en={item.en} data-ar={item.ar}>{item.ar}</li>)}</ul>
      </div>
    </div>
    <p class="final-statement" data-en={partners.final.en} data-ar={partners.final.ar}>{partners.final.ar}</p>
    <div class="partner-actions">
      <a class="pill-button pill-button-light" href={`https://wa.me/967${contact.phone}`} target="_blank" rel="noreferrer"><span dir="ltr">+967 779779630</span><b aria-hidden="true">↗</b></a>
      <a class="pill-button pill-button-line" href={`mailto:${contact.email}`}><span>{contact.email}</span><b aria-hidden="true">↗</b></a>
    </div>
  </div>
</section>
