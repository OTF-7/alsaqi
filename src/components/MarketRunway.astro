---
import { Image } from "astro:assets";
import marketPhoto from "../assets/alsaqi/12-market-launch.jpg";
import { market, marketPhases } from "../data/alsaqi";

const phases = [marketPhases.launch, marketPhases.establish, marketPhases.expand];
---

<section class="site-section market-section" id="market">
  <div class="site-shell section-content reveal">
    <header class="section-heading">
      <span class="section-number">07</span>
      <h2 data-en={market.title.en} data-ar={market.title.ar}>{market.title.ar}</h2>
    </header>

    <div class="market-philosophy">
      <p data-en={market.philosophy.en} data-ar={market.philosophy.ar}>{market.philosophy.ar}</p>
      <ul>{market.philosophyPoints.map((point) => <li data-en={point.en} data-ar={point.ar}>{point.ar}</li>)}</ul>
    </div>

    <div class="equation-set" data-equation>
      <p data-en={market.equationTitle.en} data-ar={market.equationTitle.ar}>{market.equationTitle.ar}</p>
      <div class="equation-row">
        {market.equationParts.map((part, index) => (
          <Fragment><span class="equation-term" data-stagger={index} data-en={part.en} data-ar={part.ar}>{part.ar}</span>{index < market.equationParts.length - 1 && <b aria-hidden="true">+</b>}</Fragment>
        ))}
        <b aria-hidden="true">=</b><strong data-en={market.equationResult.en} data-ar={market.equationResult.ar}>{market.equationResult.ar}</strong>
      </div>
    </div>

    <div class="phase-band">
      <figure class="phase-photo" aria-hidden="true"><Image src={marketPhoto} alt="" widths={[900, 1400, 2000]} sizes="100vw" loading="lazy" /></figure>
      <div class="phase-timeline">
        {phases.map((phase, index) => (
          <article class="phase-card" tabindex="0">
            <span>0{index + 1}</span><h3 data-en={phase.title.en} data-ar={phase.title.ar}>{phase.title.ar}</h3>
            <ul>{phase.points.map((point) => <li data-en={point.en} data-ar={point.ar}>{point.ar}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>

    <ol class="advantage-grid">
      {market.advantages.map((item, index) => <li tabindex="0"><span>0{index + 1}</span><p data-en={item.en} data-ar={item.ar}>{item.ar}</p></li>)}
    </ol>
  </div>
</section>
