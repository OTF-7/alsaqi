---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { contact, hero } from "../data/alsaqi";

const links = [
  { href: "#about", en: "Executive summary", ar: "الملخص التنفيذي" },
  { href: "#products", en: "Products", ar: "المنتجات" },
  { href: "#quality", en: "Quality and standards", ar: "الجودة والمعايير" },
  { href: "#growth", en: "Growth and expansion opportunities", ar: "فرص النمو والتوسع" },
  { href: "#partners", en: "An invitation to partner", ar: "دعوة للشراكة" },
];
---

<footer class="water-footer" id="footer" data-wave-footer style="--water-y:180px">
  <svg class="footer-skyline" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
    <g>
      <path d="M0 148H1440M80 148V83H130V148M72 83L84 70V83M105 83V68M130 83L120 69M142 148V49H210V148M134 49L151 31L166 49L180 28L195 49L207 33L216 49M225 148V91H277V148M217 91L231 78V91M251 91V77M277 91L267 77" />
      <path d="M770 148V70H826V148M762 70L778 54V70M798 70V52M826 70L816 54M839 148V38H914V148M830 38L848 18L864 38L881 15L897 38L910 20L922 38M930 148V86H986V148M922 86L937 71V86M960 86V70M986 86L976 71" />
      <path d="M84 104H124M84 125H124M151 75H201M151 101H201M151 126H201M233 112H269M774 94H817M774 121H817M848 67H905M848 96H905M848 125H905M938 110H978" />
    </g>
  </svg>

  <svg class="footer-water" viewBox="0 0 1440 760" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="saqi-sea-gradient" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#4ea832" />
        <stop offset=".025" stop-color="#2fa8c9" />
        <stop offset=".12" stop-color="#0f5c85" />
        <stop offset=".62" stop-color="#0a3554" />
        <stop offset="1" stop-color="#041624" />
      </linearGradient>
    </defs>
    <path id="footer-wave" fill="url(#saqi-sea-gradient)" d="M0 764L0 180C180 172 180 190 360 184C540 177 540 167 720 180C900 193 900 173 1080 180C1260 187 1260 170 1440 180L1440 764Z" />
  </svg>

  <div class="site-shell footer-content">
    <div class="footer-brand">
      <Image src={logo} alt="شعار الساقي" data-alt-en="Al Saqi logo" data-alt-ar="شعار الساقي" widths={[120, 180, 240]} sizes="120px" loading="lazy" />
      <p data-en={hero.title.en} data-ar={hero.title.ar}>{hero.title.ar}</p>
      <span>مصنع الساقي للمياه المعدنية | Al Saqi Mineral Water Factory</span>
    </div>
    <nav class="footer-links" aria-label="التنقل" data-aria-en="Footer navigation" data-aria-ar="التنقل">
      {links.map((link) => <a href={link.href} data-en={link.en} data-ar={link.ar}>{link.ar}</a>)}
    </nav>
    <address class="footer-contact">
      <a href={`tel:${contact.phone}`} dir="ltr">779779630</a>
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
      <a href={`https://${contact.website}`}>{contact.website}</a>
    </address>
  </div>
  <div class="site-shell footer-bottom">
    <span data-en="All rights reserved to Al-Romana Foundation for Advertising &amp; Marketing — Digital Marketing &amp; Multimedia Division, 2026" data-ar="جميع الحقوق محفوظه لدى مؤسسة الرمانة للدعاية والإعلان قطاع التسويق الإلكتروني والملتيميديا 2026">جميع الحقوق محفوظه لدى مؤسسة الرمانة للدعاية والإعلان قطاع التسويق الإلكتروني والملتيميديا 2026</span>
    <a href="#top" aria-label="العودة للأعلى" data-aria-en="Back to top" data-aria-ar="العودة للأعلى">↑</a>
  </div>
</footer>
