---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { contact, hero } from "../data/alsaqi";

const links = [
  { href: "#about", en: "Executive summary", ar: "الملخص التنفيذي" },
  { href: "#products", en: "Products", ar: "المنتجات" },
  { href: "#quality", en: "Quality and standards", ar: "الجودة والمعايير" },
  { href: "#growth", en: "Growth and expansion opportunities", ar: "فرص النمو والتوسع" },
  { href: "#partners", en: "An invitation to partner", ar: "دعوة للشراكة" },
];
---

<footer class="factory-footer" id="footer">
  <div class="footer-register" aria-hidden="true">
    <span>11 / CONTACT</span>
    <span>AL SAQI MINERAL WATER FACTORY</span>
    <span>YEMEN / 2026</span>
  </div>

  <div class="site-shell footer-statement">
    <span class="footer-statement-index" aria-hidden="true">11</span>
    <p data-en={hero.title.en} data-ar={hero.title.ar}>{hero.title.ar}</p>
    <a href={`https://wa.me/967${contact.phone}`} target="_blank" rel="noreferrer">
      <span data-en="Start a conversation" data-ar="ابدأ المحادثة">ابدأ المحادثة</span><b aria-hidden="true">↗</b>
    </a>
  </div>

  <div class="site-shell footer-content">
    <div class="footer-brand">
      <Image src={logo} alt="شعار الساقي" data-alt-en="Al Saqi logo" data-alt-ar="شعار الساقي" widths={[120, 180, 240]} sizes="120px" loading="lazy" />
      <span>مصنع الساقي للمياه المعدنية | Al Saqi Mineral Water Factory</span>
    </div>
    <nav class="footer-links" aria-label="التنقل" data-aria-en="Footer navigation" data-aria-ar="التنقل">
      {links.map((link) => <a href={link.href} data-en={link.en} data-ar={link.ar}>{link.ar}</a>)}
    </nav>
    <address class="footer-contact">
      <span>CONTACT / 03</span>
      <a href={`tel:${contact.phone}`} dir="ltr">+967 {contact.phone}</a>
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
      <a href={`https://${contact.website}`}>{contact.website}</a>
    </address>
  </div>
  <div class="site-shell footer-bottom">
    <span data-en="All rights reserved to Al-Romana Foundation for Advertising &amp; Marketing — Digital Marketing &amp; Multimedia Division, 2026" data-ar="جميع الحقوق محفوظه لدى مؤسسة الرمانة للدعاية والإعلان قطاع التسويق الإلكتروني والملتيميديا 2026">جميع الحقوق محفوظه لدى مؤسسة الرمانة للدعاية والإعلان قطاع التسويق الإلكتروني والملتيميديا 2026</span>
    <a href="#top" aria-label="العودة للأعلى" data-aria-en="Back to top" data-aria-ar="العودة للأعلى">↑</a>
  </div>
</footer>
