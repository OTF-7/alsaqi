---
import { Image } from "astro:assets";
import bottle330 from "../assets/alsaqi/cutouts/bottle-330.png";
import bottle750 from "../assets/alsaqi/cutouts/bottle-750.png";
import bottle1200 from "../assets/alsaqi/cutouts/bottle-1200.png";
import { hero } from "../data/alsaqi";

const bottles = [
  { id: "330", src: bottle330, label: "330 ml", labelAr: "330 مل", className: "hero-bottle-small", alt: "Al Saqi 330 ml bottle", altAr: "عبوة الساقي سعة 330 مل" },
  { id: "1200", src: bottle1200, label: "1200 ml", labelAr: "1200 مل", className: "hero-bottle-large", alt: "Al Saqi 1200 ml bottle", altAr: "عبوة الساقي سعة 1200 مل" },
  { id: "750", src: bottle750, label: "750 ml", labelAr: "750 مل", className: "hero-bottle-medium", alt: "Al Saqi 750 ml bottle", altAr: "عبوة الساقي سعة 750 مل" },
];
---

<section class="raqi-hero" id="top" aria-labelledby="hero-title">
  <div class="site-shell hero-layout">
    <div class="hero-copy reveal">
      <p class="section-kicker" data-en={hero.kicker.en} data-ar={hero.kicker.ar}>{hero.kicker.ar}</p>
      <h1 id="hero-title" data-en={hero.title.en} data-ar={hero.title.ar}>{hero.title.ar}</h1>
      <p class="hero-support" data-en={hero.support.en} data-ar={hero.support.ar}>{hero.support.ar}</p>
      <div class="hero-actions">
        <a class="pill-button pill-button-light" href="#products"><span data-en={hero.primaryCta.en} data-ar={hero.primaryCta.ar}>{hero.primaryCta.ar}</span><b aria-hidden="true">←</b></a>
        <a class="pill-button pill-button-line" href="#partners"><span data-en={hero.partnerCta.en} data-ar={hero.partnerCta.ar}>{hero.partnerCta.ar}</span><b aria-hidden="true">↗</b></a>
      </div>
      <p class="hero-brand-line" data-en={hero.brand.en} data-ar={hero.brand.ar}>{hero.brand.ar}</p>
    </div>

    <div class="hero-products reveal" aria-label="أحجام عبوات الساقي" data-aria-en="Al Saqi bottle sizes" data-aria-ar="أحجام عبوات الساقي">
      <div class="hero-spotlight" aria-hidden="true"></div>
      <div class="hero-bottles">
        {bottles.map((bottle) => (
          <figure class:list={["hero-bottle", bottle.className]} tabindex="0">
            <Image src={bottle.src} alt={bottle.altAr} data-alt-en={bottle.alt} data-alt-ar={bottle.altAr} widths={[180, 280, 420]} sizes="(max-width: 700px) 28vw, 13vw" loading="eager" />
            <figcaption data-en={bottle.label} data-ar={bottle.labelAr}>{bottle.labelAr}</figcaption>
          </figure>
        ))}
      </div>
      <div class="hero-surface" aria-hidden="true"><span></span></div>
    </div>
  </div>
</section>
