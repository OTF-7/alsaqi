---
import { Image } from "astro:assets";
import factoryPhoto from "../assets/alsaqi/13-factory-line.webp";
import { factory } from "../data/alsaqi";
---

<section class="site-section factory-section" id="factory">
  <div class="site-shell section-content reveal">
    <header class="section-heading">
      <span class="section-number">05</span>
      <h2 data-en={factory.title.en} data-ar={factory.title.ar}>{factory.title.ar}</h2>
    </header>

    <div class="factory-stage">
      <figure class="factory-photo">
        <Image src={factoryPhoto} alt="خطوط إنتاج أوتوماتيكية عالية الكفاءة" data-alt-en="Efficient Al Saqi automated production line" data-alt-ar="خطوط إنتاج أوتوماتيكية عالية الكفاءة" widths={[720, 1080, 1600]} sizes="(max-width: 900px) 100vw, 58vw" loading="lazy" />
        <figcaption>PLC / HMI <span>•</span> AUTO <span>•</span> QC</figcaption>
      </figure>
      <ol class="capability-list">
        {factory.capabilities.map((item, index) => <li tabindex="0"><span>0{index + 1}</span><p data-en={item.en} data-ar={item.ar}>{item.ar}</p></li>)}
      </ol>
    </div>

    <div class="methodology-block">
      <p data-en={factory.methodologyIntro.en} data-ar={factory.methodologyIntro.ar}>{factory.methodologyIntro.ar}</p>
      <ul>{factory.methodology.map((item) => <li data-en={item.en} data-ar={item.ar}>{item.ar}</li>)}</ul>
    </div>
  </div>
</section>
