---
import { Image } from "astro:assets";
import responsibilityPhoto from "../assets/alsaqi/15-responsibility-world.jpg";
import { responsibility } from "../data/alsaqi";
---

<section class="site-section responsibility-section" id="responsibility" data-draw-section>
  <div class="site-shell section-content reveal">
    <header class="section-heading">
      <span class="section-number">09</span>
      <h2 data-en={responsibility.title.en} data-ar={responsibility.title.ar}>{responsibility.title.ar}</h2>
    </header>
    <div class="responsibility-intro">
      <p class="section-lead" data-en={responsibility.intro.en} data-ar={responsibility.intro.ar}>{responsibility.intro.ar}</p>
      <ul>{responsibility.actions.map((item) => <li data-en={item.en} data-ar={item.ar}>{item.ar}</li>)}</ul>
    </div>
    {/* The brochure's own responsibility artwork already maps these four
        pillars, so it is shown whole rather than cropped behind copy. */}
    <figure class="responsibility-figure">
      <Image src={responsibilityPhoto} alt="أثر الساقي على البيئة والصحة والمجتمع والاقتصاد" data-alt-en="Al Saqi's impact across environment, health, community and economy" data-alt-ar="أثر الساقي على البيئة والصحة والمجتمع والاقتصاد" widths={[640, 900, 1280]} sizes="(max-width: 760px) 100vw, 60vw" loading="lazy" />
    </figure>
    <div class="responsibility-grid">
      {responsibility.pillars.map((pillar, index) => (
        <article tabindex="0" style={`--i:${index}`}>
          <span>0{index + 1}</span>
          <div class="pillar-drop" aria-hidden="true">
            <svg viewBox="0 0 70 90"><path d="M35 4C29 20 10 39 10 57C10 74 21 84 35 84C49 84 60 74 60 57C60 39 41 20 35 4Z" /></svg>
            <i></i>
          </div>
          <h3 data-en={pillar.title.en} data-ar={pillar.title.ar}>{pillar.title.ar}</h3><p data-en={pillar.text.en} data-ar={pillar.text.ar}>{pillar.text.ar}</p>
        </article>
      ))}
    </div>
  </div>
</section>
