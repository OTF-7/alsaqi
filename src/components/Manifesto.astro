---
import { Image } from "astro:assets";
import podiumPhoto from "../assets/alsaqi/03-first-place.jpg";
import { about } from "../data/alsaqi";
---

<section class="site-section about-section" id="about">
  <div class="site-shell section-content reveal">
    <header class="section-heading">
      <span class="section-number">01</span>
      <h2 data-en={about.title.en} data-ar={about.title.ar}>{about.title.ar}</h2>
    </header>
    <div class="about-intro">
      <div class="about-copy">
        <p class="section-lead" data-en={about.intro.en} data-ar={about.intro.ar}>{about.intro.ar}</p>
        <p data-en={about.bridge.en} data-ar={about.bridge.ar}>{about.bridge.ar}</p>
      </div>
      <figure class="about-photo">
        <Image src={podiumPhoto} alt="عبوة الساقي في المركز الأول" data-alt-en="Al Saqi bottle on the first-place podium" data-alt-ar="عبوة الساقي في المركز الأول" widths={[520, 800, 1100]} sizes="(max-width: 760px) 100vw, 38vw" loading="lazy" />
      </figure>
    </div>
    <ol class="pillar-grid">
      {about.pillars.map((pillar, index) => (
        <li tabindex="0"><span>0{index + 1}</span><p data-en={pillar.en} data-ar={pillar.ar}>{pillar.ar}</p></li>
      ))}
    </ol>
    <p class="display-close" data-en={about.close.en} data-ar={about.close.ar}>{about.close.ar}</p>
  </div>
</section>
