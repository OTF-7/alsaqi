---
import { Image } from "astro:assets";
import growthPhoto from "../assets/alsaqi/16-growth-retail.webp";
import { growth } from "../data/alsaqi";
---

<section class="site-section growth-section" id="growth">
  <div class="site-shell section-content reveal">
    <header class="section-heading">
      <span class="section-number">10</span>
      <h2 data-en={growth.title.en} data-ar={growth.title.ar}>{growth.title.ar}</h2>
    </header>
    <div class="growth-band" data-draw-section>
      <figure class="growth-photo" aria-hidden="true"><Image src={growthPhoto} alt="" widths={[900, 1400, 2000]} sizes="100vw" loading="lazy" /></figure>
      <svg class="growth-links" viewBox="0 0 1200 260" preserveAspectRatio="none" aria-hidden="true">
        <path class="draw-path" pathLength="1" d="M165 130H435M465 130H735M765 130H1035" />
      </svg>
      <div class="growth-grid">
        {growth.opportunities.map((item, index) => (
          <article tabindex="0"><span>0{index + 1}</span><p data-en={item.en} data-ar={item.ar}>{item.ar}</p><i aria-hidden="true">↗</i></article>
        ))}
      </div>
    </div>

    <div class="business-model">
      <div class="model-routes">
        {growth.model.map((item, index) => <article tabindex="0"><span>0{index + 1}</span><p data-en={item.en} data-ar={item.ar}>{item.ar}</p></article>)}
      </div>
      <div class="model-basis">
        <p data-en={growth.modelIntro.en} data-ar={growth.modelIntro.ar}>{growth.modelIntro.ar}</p>
        <ul>{growth.modelBasis.map((item) => <li data-en={item.en} data-ar={item.ar}>{item.ar}</li>)}</ul>
      </div>
    </div>
  </div>
</section>
